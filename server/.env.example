DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="dev"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NODE_ENV="development"
# Optional: without an email provider, the codes are only printed in the server log (development).
# Gmail (used first when both are set): the address and a Google "app password" (needs 2-step verification).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Resend (used only without Gmail): without a verified domain it delivers only to the Resend account's address.
RESEND_API_KEY=""
EMAIL_FROM="MOPS <onboarding@resend.dev>"

# Production only (Vercel): "true" lets the app opened in Expo Go sign in (origin exp://).
ALLOW_EXPO_GO=""

# US-09: OCR microservice (llama.cpp with Qwen3-VL) and where uploaded photos are kept.
OCR_URL="http://127.0.0.1:8080"
OCR_TIMEOUT_MS="300000"
UPLOAD_DIR="uploads"
